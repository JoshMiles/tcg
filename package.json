{
  "name": "tcg-widget",
  "version": "1.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "node scripts/build-changelog.mjs --ensure",
    "dev": "next dev",
    "build": "node scripts/build-changelog.mjs && next build",
    "analyze": "node scripts/build-changelog.mjs --ensure && next build --webpack",
    "start": "next start",
    "check": "node scripts/build-changelog.mjs --ensure && node scripts/run-checks.mjs",
    "typecheck": "node scripts/build-changelog.mjs --ensure && tsc --noEmit",
    "verify": "npm run typecheck && npm run check && node --check public/widget.js && node --check public/widget-dev.js",
    "review:seed": "tsx scripts/seed-review.mts",
    "review:public": "node scripts/sweep-public.mjs",
    "review:admin": "node scripts/sweep-admin.mjs",
    "review:mod": "node scripts/sweep-mod-access.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.3",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "daisyui": "^5.7.50",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "^7.1.6",
    "zod": "^4.6.6"
  }
}
