{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "tv.cheesygidds.tcgbridge",
  "Name": "TCG Bridge",
  "Version": "0.40.0.0",
  "Author": "CheesyGidds",
  "Description": "Buffs, pause pulls, happy hours, test pulls, show a card and live stats for the stream, run through the TCG Bridge app on the same PC.",
  "Category": "TCG Bridge",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "CodePath": "bin/plugin.js",
  "Actions": [
    {
      "UUID": "tv.cheesygidds.tcgbridge.buff",
      "Name": "Buff",
      "Tooltip": "Fires one Stream Deck buff or quick action.",
      "Icon": "imgs/actions/buff",
      "PropertyInspectorPath": "ui/buff.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/buff",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.last-buff",
      "Name": "Last buff again",
      "Tooltip": "Fires the last buff again.",
      "Icon": "imgs/actions/last-buff",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/last-buff",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.pause",
      "Name": "Pause pulls",
      "Tooltip": "Pauses or resumes pack pulls.",
      "Icon": "imgs/actions/pause",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/pause",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.happy-hour",
      "Name": "Happy hour",
      "Tooltip": "Starts a happy hour. While one runs, hold the key for a second to end it.",
      "Icon": "imgs/actions/happy-hour",
      "PropertyInspectorPath": "ui/happy-hour.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/happy-hour",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.test-pull",
      "Name": "Test pull",
      "Tooltip": "Plays a test pull on the overlay. Admin staff PC only. While OBS is live, hold it for 1 second.",
      "Icon": "imgs/actions/test-pull",
      "PropertyInspectorPath": "ui/test-pull.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/test-pull",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.show-card",
      "Name": "Show a card",
      "Tooltip": "Shows a card of the viewer named in the key's settings (and the card, if you pick one) on the overlay. Admin staff PC only. While OBS is live, hold it for 1 second.",
      "Icon": "imgs/actions/show-card",
      "PropertyInspectorPath": "ui/show-card.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/show-card",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.stat",
      "Name": "Stat",
      "Tooltip": "Shows the queue length, the packs this stream or the pack goal. A queue key skips the next pull on a second press within 3 seconds.",
      "Icon": "imgs/actions/stat",
      "PropertyInspectorPath": "ui/stat.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/stat",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.skip",
      "Name": "Skip next pull",
      "Tooltip": "Skips the next pull in the queue. A paid pull is refunded.",
      "Icon": "imgs/actions/skip",
      "PropertyInspectorPath": "ui/skip.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/skip",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.clear-queue",
      "Name": "Clear queue",
      "Tooltip": "Hold the key for a second to clear the whole queue. Paid pulls are refunded.",
      "Icon": "imgs/actions/clear-queue",
      "PropertyInspectorPath": "ui/clear-queue.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/clear-queue",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.queue",
      "Name": "Pulls waiting",
      "Tooltip": "Shows how many pulls are waiting in the queue.",
      "Icon": "imgs/actions/queue",
      "PropertyInspectorPath": "ui/queue.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/queue",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.trading",
      "Name": "Pause trading",
      "Tooltip": "Staff PC only. Shows whether trading is open or paused; press to open it, hold for 1 second to pause it.",
      "Icon": "imgs/actions/trading",
      "PropertyInspectorPath": "ui/trading.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/trading",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.scene",
      "Name": "Switch scene",
      "Tooltip": "Staff PC only. Switches OBS to the scene picked in the key's settings.",
      "Icon": "imgs/actions/scene",
      "PropertyInspectorPath": "ui/scene.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/scene",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.preview",
      "Name": "Preview overlay",
      "Tooltip": "Admin staff PC only. Opens the Preview overlay window in TCG Bridge.",
      "Icon": "imgs/actions/preview",
      "PropertyInspectorPath": "ui/preview.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/preview",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.refresh",
      "Name": "Refresh overlay",
      "Tooltip": "Refreshes the overlay browser source in OBS, the same as the Refresh the overlay button and hotkey.",
      "Icon": "imgs/actions/refresh",
      "PropertyInspectorPath": "ui/refresh.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/refresh",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "tv.cheesygidds.tcgbridge.checklist",
      "Name": "Run checklist",
      "Tooltip": "Runs the pre-stream checklist. The key turns green (all OK) or red (the number failing) and keeps the result until the next run.",
      "Icon": "imgs/actions/checklist",
      "PropertyInspectorPath": "ui/checklist.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/checklist",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ]
    }
  ]
}