{
  "name": "tcg-bridge",
  "productName": "TCG Bridge",
  "version": "0.13.0",
  "description": "Carries the TCG site's Mix It Up requests to Mix It Up on the stream PC.",
  "private": true,
  "author": "Cheesygidds TCG",
  "main": "dist/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsx scripts/check.ts",
    "icons": "tsx scripts/make-icons.ts",
    "start": "npm run build && electron .",
    "stamp": "node scripts/stamp.mjs",
    "dist": "npm run stamp && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "obs-websocket-js": "^5.0.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "app.cheesytcg.bridge",
    "productName": "TCG Bridge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "!dist/demo.js",
      "renderer/**",
      "assets/**",
      "package.json",
      "build-info.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TCG-Bridge-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "JoshMiles",
      "repo": "tcg"
    }
  }
}
